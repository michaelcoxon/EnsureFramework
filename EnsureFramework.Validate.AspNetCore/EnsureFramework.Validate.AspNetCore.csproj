<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EnsureFramework</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Michael Coxon</Authors>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Description>
      Extensions to the EnsureFramework.Validate that allow you to apply it to the ModelState.
    </Description>
    <Copyright>Copyright 2018-2026</Copyright>
    <PackageProjectUrl>https://github.com/michaelcoxon/EnsureFramework</PackageProjectUrl>
    <RepositoryUrl>https://github.com/michaelcoxon/EnsureFramework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>validation,aspnetcore-validation,aspnetcore</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>2.0.3-alpha</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CodeAnalysisRuleSet>../EnsureFramework.ruleset</CodeAnalysisRuleSet>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Abstractions" Version="2.3.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnsureFramework.Validate\EnsureFramework.Validate.csproj" />
  </ItemGroup>

</Project>
